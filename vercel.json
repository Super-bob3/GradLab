{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "gradlab.app" }], "destination": "https://www.gradlab.app/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/stats/script.js", "destination": "https://cloud.umami.is/script.js" },
    { "source": "/stats/api/send",  "destination": "https://cloud.umami.is/api/send" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy",   "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy",  "value": "credentialless" }
      ]
    }
  ]
}
